# ==============================================================================
# 📐 考研数学知识库 · 环境变量配置模板
# ==============================================================================

# 本地静态服务监听端口 (默认 5210)
MATH_PORT=5210

# 本地服务绑定主机地址 (0.0.0.0 支持局域网手机 Wi-Fi 访问)
MATH_HOST=0.0.0.0

# GitHub 远程仓库名称与 GitHub Pages 发布地址
GITHUB_REPO=xunyuefei/kaoyan-math
GITHUB_PAGES_URL=https://xunyuefei.github.io/kaoyan-math/

# Node.js 环境配置
NODE_ENV=production
